# FraudShield AI Platform - Environment Variables
# Copy this file to .env and fill in your values

# ============================================
# REQUIRED: Gemini API (for AI features)
# ============================================
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_NAME=gemini-2.0-flash-exp
GEMINI_EMBED_MODEL_NAME=embedding-001

# ============================================
# OPTIONAL: OpenAI (if you want to use it)
# ============================================
# OPENAI_API_KEY=your_openai_api_key_here

# ============================================
# Database (external Postgres required for production)
# Example: postgresql://user:password@db-host:5432/fraudshield
# ============================================
DATABASE_URL=postgresql://user:password@your-db-host:5432/fraudshield

# ============================================
# App Settings
# ============================================
UPLOADS_DIR=./data/uploads

# Comma-separated list of frontend origins allowed by CORS
ALLOWED_ORIGINS=http://localhost:5173
